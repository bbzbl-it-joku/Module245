# Public Convex deployment URL used by the client
NEXT_PUBLIC_CONVEX_URL=

# Public site URL used by Convex Auth
CONVEX_SITE_URL=http://localhost:3000

# Convex Auth keys (generate with node generateKeys.mjs or npx @convex-dev/auth)
JWT_PRIVATE_KEY=
JWKS=

# Deploy key for Convex production/preview environments
CONVEX_DEPLOY_KEY=
